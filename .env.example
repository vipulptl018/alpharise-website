# Production / Vercel environment template
# Copy to .env.local for local development (never commit .env.local).

# FastAPI backend base URL (no trailing slash). Required for the Contact and Newsletter forms.
# Local example: http://localhost:8000
# Production: the public URL Render shows for the API service, e.g. https://<service>.onrender.com
# Do NOT use https://api.alphariseinnovation.com unless it is a CNAME to this API:
# that hostname currently serves a different AlphaRise backend (Sinchan Mitra).
NEXT_PUBLIC_API_URL=

# Canonical public site URL (no trailing slash). Use the www host: the bare domain
# redirects to www on Vercel, and canonical / sitemap / Open Graph URLs must not
# point at a redirect.
NEXT_PUBLIC_SITE_URL=https://www.alphariseinnovation.com

NEXT_PUBLIC_COMPANY_NAME=ALPHARISE INNOVATION PRIVATE LIMITED
NEXT_PUBLIC_COMPANY_PHONE=+919168020295
NEXT_PUBLIC_COMPANY_EMAIL=admin@alphariseinnovation.com
NEXT_PUBLIC_COMPANY_CIN=U62091PN2026PTC253412
NEXT_PUBLIC_COMPANY_GSTIN=Not Applicable

# Sinchan Mitra download buttons (/sinchan-mitra). Leave empty until the files are published:
# the page then shows "coming soon" and a link to ask for access.
NEXT_PUBLIC_SINCHAN_MITRA_WINDOWS_URL=
NEXT_PUBLIC_SINCHAN_MITRA_ANDROID_URL=
