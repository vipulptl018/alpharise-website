# Application
APP_NAME=ALPHARISE API
# development | production
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-production-secret-key-64chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Server
HOST=0.0.0.0
# Local default. On Render, PORT is injected automatically — do not set it there.
PORT=8000

# PostgreSQL
# Supabase (Render): postgresql://postgres.[REF]:[PASSWORD]@...pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/alpharise

# Redis — leave blank (not used for Contact-only Render Free)
REDIS_URL=

# CORS
CORS_ORIGINS=http://localhost:3000,https://alphariseinnovation.com,https://www.alphariseinnovation.com
# Vercel preview deployments
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Rate limiting (in-memory; no Redis required)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PUBLIC=20/minute

# Resend HTTPS email (works on Render Free — https://resend.com)
RESEND_API_KEY=
RESEND_FROM=ALPHARISE <noreply@alphariseinnovation.com>
CONTACT_NOTIFY_EMAIL=admin@alphariseinnovation.com
HR_NOTIFY_EMAIL=admin@alphariseinnovation.com

# Uploads (ephemeral on Render Free; Contact API does not require files)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Bootstrap admin (created on first startup if missing; not used by public Contact form)
# The password below is only a placeholder and is public in this repo: on Render always
# set BOOTSTRAP_ADMIN_PASSWORD to a strong unique value, or the admin account is created with it.
BOOTSTRAP_ADMIN_EMAIL=admin@alphariseinnovation.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ADMIN_FULL_NAME=ALPHARISE Admin

# Logging
LOG_LEVEL=INFO
