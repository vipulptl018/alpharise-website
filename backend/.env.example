# Application
APP_NAME=ALPHARISE API
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-production-secret-key-64chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/alpharise

# Redis (optional — leave blank to disable)
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://alphariseinnovation.com,https://www.alphariseinnovation.com

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PUBLIC=20/minute

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@alphariseinnovation.com
SMTP_FROM_NAME=ALPHARISE
CONTACT_NOTIFY_EMAIL=admin@alphariseinnovation.com
HR_NOTIFY_EMAIL=admin@alphariseinnovation.com

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Bootstrap admin (created on first startup if missing)
BOOTSTRAP_ADMIN_EMAIL=admin@alphariseinnovation.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ADMIN_FULL_NAME=ALPHARISE Admin

# Logging
LOG_LEVEL=INFO
